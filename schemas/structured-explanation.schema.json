{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dsc/structured-explanation.schema.json",
  "title": "Structured Scheduling Explanation",
  "type": "object",
  "required": [
    "schema_version",
    "explanation_id",
    "decision_scope",
    "scenario_id",
    "activity_id",
    "previous_start",
    "previous_finish",
    "proposed_start",
    "proposed_finish",
    "movement",
    "movement_basis",
    "reason_type",
    "governing_entity",
    "selected_objective_vector",
    "counterfactuals",
    "model_version",
    "solver_version",
    "objective_policy_version",
    "input_hash",
    "output_hash",
    "recomputation"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.2"
    },
    "explanation_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_scope": {
      "enum": [
        "calculation_trace",
        "optimisation_scenario"
      ]
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "activity_id": {
      "type": "string",
      "minLength": 1
    },
    "previous_start": {
      "type": [
        "integer",
        "null"
      ]
    },
    "previous_finish": {
      "type": [
        "integer",
        "null"
      ]
    },
    "proposed_start": {
      "type": [
        "integer",
        "null"
      ]
    },
    "proposed_finish": {
      "type": [
        "integer",
        "null"
      ]
    },
    "movement": {
      "type": "integer"
    },
    "movement_basis": {
      "enum": [
        "start",
        "finish",
        "both"
      ]
    },
    "reason_type": {
      "enum": [
        "precedence",
        "calendar",
        "date_constraint",
        "resource_conflict",
        "operational_exclusion",
        "objective_tradeoff",
        "canonical_tie_break",
        "inherited_downstream",
        "actual_progress"
      ]
    },
    "governing_entity": {
      "oneOf": [
        {
          "$ref": "#/$defs/governingEntity"
        },
        {
          "type": "null"
        }
      ]
    },
    "conflicting_activity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "affected_milestone_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "selection_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_objective_vector": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceReference"
      },
      "default": []
    },
    "counterfactuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/counterfactual"
      }
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "solver_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "objective_policy_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_hash": {
      "$ref": "#/$defs/hash"
    },
    "output_hash": {
      "$ref": "#/$defs/hash"
    },
    "recomputation": {
      "$ref": "#/$defs/recomputation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "movement": {
            "not": {
              "const": 0
            }
          }
        },
        "required": [
          "movement"
        ]
      },
      "then": {
        "properties": {
          "governing_entity": {
            "$ref": "#/$defs/governingEntity"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_scope": {
            "const": "optimisation_scenario"
          }
        },
        "required": [
          "decision_scope"
        ]
      },
      "then": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "selected_objective_vector": {
            "minItems": 1
          },
          "counterfactuals": {
            "minItems": 1
          },
          "solver_version": {
            "type": "string",
            "minLength": 1
          },
          "objective_policy_version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_type": {
            "const": "resource_conflict"
          }
        },
        "required": [
          "reason_type"
        ]
      },
      "then": {
        "properties": {
          "governing_entity": {
            "allOf": [
              {
                "$ref": "#/$defs/governingEntity"
              },
              {
                "properties": {
                  "type": {
                    "const": "resource"
                  }
                }
              }
            ]
          },
          "conflicting_activity_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_type": {
            "const": "precedence"
          }
        },
        "required": [
          "reason_type"
        ]
      },
      "then": {
        "properties": {
          "governing_entity": {
            "allOf": [
              {
                "$ref": "#/$defs/governingEntity"
              },
              {
                "properties": {
                  "type": {
                    "const": "relationship"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_type": {
            "const": "calendar"
          }
        },
        "required": [
          "reason_type"
        ]
      },
      "then": {
        "properties": {
          "governing_entity": {
            "allOf": [
              {
                "$ref": "#/$defs/governingEntity"
              },
              {
                "properties": {
                  "type": {
                    "const": "calendar"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_type": {
            "const": "date_constraint"
          }
        },
        "required": [
          "reason_type"
        ]
      },
      "then": {
        "properties": {
          "governing_entity": {
            "allOf": [
              {
                "$ref": "#/$defs/governingEntity"
              },
              {
                "properties": {
                  "type": {
                    "const": "constraint"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_type": {
            "const": "operational_exclusion"
          }
        },
        "required": [
          "reason_type"
        ]
      },
      "then": {
        "properties": {
          "governing_entity": {
            "allOf": [
              {
                "$ref": "#/$defs/governingEntity"
              },
              {
                "properties": {
                  "type": {
                    "const": "operational_constraint"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_type": {
            "enum": [
              "objective_tradeoff",
              "canonical_tie_break"
            ]
          }
        },
        "required": [
          "reason_type"
        ]
      },
      "then": {
        "properties": {
          "governing_entity": {
            "allOf": [
              {
                "$ref": "#/$defs/governingEntity"
              },
              {
                "properties": {
                  "type": {
                    "const": "objective_policy"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "governingEntity": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "relationship",
            "calendar",
            "constraint",
            "resource",
            "operational_constraint",
            "objective_policy",
            "activity",
            "actual_event"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_field": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidenceReference": {
      "type": "object",
      "required": [
        "id",
        "path_or_uri",
        "hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path_or_uri": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "patchOperation": {
      "type": "object",
      "required": [
        "op",
        "path"
      ],
      "properties": {
        "op": {
          "enum": [
            "add",
            "remove",
            "replace"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "add",
                  "replace"
                ]
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "milestoneImpact": {
      "type": "object",
      "required": [
        "milestone_id",
        "movement"
      ],
      "properties": {
        "milestone_id": {
          "type": "string",
          "minLength": 1
        },
        "movement": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "counterfactual": {
      "type": "object",
      "required": [
        "counterfactual_id",
        "description",
        "input_patch",
        "execution_identity",
        "result_status",
        "result_hash",
        "output_hash",
        "objective_vector",
        "validator_status",
        "evidence_paths"
      ],
      "properties": {
        "counterfactual_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input_patch": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/patchOperation"
          },
          "minItems": 1
        },
        "execution_identity": {
          "$ref": "#/$defs/hash"
        },
        "result_status": {
          "enum": [
            "feasible",
            "infeasible",
            "unknown"
          ]
        },
        "result_hash": {
          "$ref": "#/$defs/hash"
        },
        "output_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "objective_vector": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "validator_status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "activity_start": {
          "type": [
            "integer",
            "null"
          ]
        },
        "activity_finish": {
          "type": [
            "integer",
            "null"
          ]
        },
        "milestone_impacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/milestoneImpact"
          },
          "default": []
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "result_status": {
                "const": "feasible"
              }
            },
            "required": [
              "result_status"
            ]
          },
          "then": {
            "properties": {
              "output_hash": {
                "$ref": "#/$defs/hash"
              },
              "objective_vector": {
                "minItems": 1
              },
              "validator_status": {
                "const": "pass"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result_status": {
                "const": "infeasible"
              }
            },
            "required": [
              "result_status"
            ]
          },
          "then": {
            "properties": {
              "output_hash": {
                "type": "null"
              },
              "objective_vector": {
                "maxItems": 0
              },
              "validator_status": {
                "const": "pass"
              }
            }
          }
        }
      ]
    },
    "recomputation": {
      "type": "object",
      "required": [
        "execution_identity",
        "validator_status",
        "evidence_paths"
      ],
      "properties": {
        "execution_identity": {
          "$ref": "#/$defs/hash"
        },
        "validator_status": {
          "const": "pass"
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
