{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dsc/canonical-schedule.schema.json",
  "title": "Canonical Schedule",
  "type": "object",
  "required": [
    "schema_version",
    "schedule_id",
    "semantic_profile",
    "time_axis",
    "project",
    "calendars",
    "activities",
    "relationships"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.3"
    },
    "schedule_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "semantic_profile": {
      "type": "string",
      "minLength": 1
    },
    "source_system": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_file_hash": {
      "oneOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "time_axis": {
      "type": "object",
      "required": [
        "unit",
        "origin",
        "horizon"
      ],
      "properties": {
        "unit": {
          "enum": [
            "minute",
            "hour"
          ]
        },
        "origin": {
          "type": "string",
          "format": "date-time"
        },
        "horizon": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": [
        "project_start"
      ],
      "properties": {
        "project_start": {
          "type": "integer"
        },
        "status_time": {
          "type": [
            "integer",
            "null"
          ]
        },
        "required_finish": {
          "type": [
            "integer",
            "null"
          ]
        },
        "progress_policy": {
          "enum": [
            "none",
            "retained_logic",
            "progress_override",
            "actual_dates",
            null
          ]
        },
        "frozen_horizon_finish": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "wbs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wbsNode"
      },
      "default": []
    },
    "calendars": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/calendar"
      },
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "default": []
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      },
      "minItems": 1
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "operational_constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operationalConstraint"
      },
      "default": []
    },
    "baseline": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/scheduleState"
            },
            {
              "properties": {
                "state_type": {
                  "const": "baseline"
                }
              },
              "required": [
                "state_type"
              ]
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "approved_forecast": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/scheduleState"
            },
            {
              "properties": {
                "state_type": {
                  "const": "approved_forecast"
                }
              },
              "required": [
                "state_type"
              ]
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "proposed_scenario": {
      "oneOf": [
        {
          "$ref": "#/$defs/proposedScenario"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "governance": {
      "$ref": "#/$defs/governance"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceFields": {
      "type": "object",
      "additionalProperties": true
    },
    "wbsNode": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "outline_order": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source_fields": {
          "$ref": "#/$defs/sourceFields"
        }
      },
      "additionalProperties": false
    },
    "calendar": {
      "type": "object",
      "required": [
        "id",
        "working_intervals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "working_intervals": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "source_fields": {
          "$ref": "#/$defs/sourceFields"
        }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": [
        "id",
        "type",
        "capacity",
        "calendar_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "renewable",
            "exclusive",
            "cumulative",
            "non_renewable"
          ]
        },
        "capacity": {
          "type": "integer",
          "minimum": 0
        },
        "calendar_id": {
          "type": "string",
          "minLength": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "certifications": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_reference": {
          "$ref": "#/$defs/sourceFields"
        },
        "source_fields": {
          "$ref": "#/$defs/sourceFields"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "exclusive"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "capacity": {
                "const": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": [
        "id",
        "type",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "start_no_earlier_than",
            "finish_no_earlier_than",
            "fixed_start",
            "fixed_finish"
          ]
        },
        "value": {
          "type": "integer"
        },
        "source_fields": {
          "$ref": "#/$defs/sourceFields"
        }
      },
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "required": [
        "resource_id",
        "demand"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "demand": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "executionMode": {
      "type": "object",
      "required": [
        "id",
        "duration",
        "assignments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "duration": {
          "type": "integer",
          "minimum": 0
        },
        "calendar_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "assignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assignment"
          }
        },
        "required_skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "parameters": {
          "$ref": "#/$defs/sourceFields"
        }
      },
      "additionalProperties": false
    },
    "frozenState": {
      "type": "object",
      "required": [
        "is_frozen"
      ],
      "properties": {
        "is_frozen": {
          "type": "boolean"
        },
        "frozen_start": {
          "type": [
            "integer",
            "null"
          ]
        },
        "frozen_finish": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "is_frozen": {
                "const": true
              }
            },
            "required": [
              "is_frozen"
            ]
          },
          "then": {
            "required": [
              "frozen_start",
              "frozen_finish"
            ],
            "properties": {
              "frozen_start": {
                "type": "integer"
              },
              "frozen_finish": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "is_frozen": {
                "const": false
              }
            },
            "required": [
              "is_frozen"
            ]
          },
          "then": {
            "properties": {
              "frozen_start": {
                "type": "null"
              },
              "frozen_finish": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "activity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "duration",
        "calendar_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "wbs_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "task",
            "start_milestone",
            "finish_milestone"
          ]
        },
        "duration": {
          "type": "integer",
          "minimum": 0
        },
        "remaining_duration": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "calendar_id": {
          "type": "string",
          "minLength": 1
        },
        "actual_start": {
          "type": [
            "integer",
            "null"
          ]
        },
        "actual_finish": {
          "type": [
            "integer",
            "null"
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          },
          "default": []
        },
        "assignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assignment"
          },
          "default": []
        },
        "eligible_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionMode"
          },
          "default": []
        },
        "frozen_state": {
          "oneOf": [
            {
              "$ref": "#/$defs/frozenState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "milestone_priority": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "due_time": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source_fields": {
          "$ref": "#/$defs/sourceFields"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "start_milestone",
                  "finish_milestone"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "duration": {
                "const": 0
              },
              "remaining_duration": {
                "enum": [
                  0,
                  null
                ]
              },
              "eligible_modes": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/executionMode"
                    },
                    {
                      "properties": {
                        "duration": {
                          "const": 0
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "actual_finish": {
                "type": "integer"
              }
            },
            "required": [
              "actual_finish"
            ]
          },
          "then": {
            "required": [
              "actual_start"
            ],
            "properties": {
              "actual_start": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "actual_start": {
                    "type": "integer"
                  }
                },
                "required": [
                  "actual_start"
                ]
              },
              {
                "anyOf": [
                  {
                    "not": {
                      "required": [
                        "actual_finish"
                      ]
                    }
                  },
                  {
                    "properties": {
                      "actual_finish": {
                        "type": "null"
                      }
                    },
                    "required": [
                      "actual_finish"
                    ]
                  }
                ]
              }
            ]
          },
          "then": {
            "required": [
              "remaining_duration"
            ],
            "properties": {
              "remaining_duration": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "predecessor_id",
        "successor_id",
        "type",
        "lag"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "predecessor_id": {
          "type": "string",
          "minLength": 1
        },
        "successor_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "FS",
            "SS",
            "FF",
            "SF"
          ]
        },
        "lag": {
          "type": "integer"
        },
        "lag_calendar": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "source_fields": {
          "$ref": "#/$defs/sourceFields"
        }
      },
      "additionalProperties": false
    },
    "operationalConstraint": {
      "type": "object",
      "required": [
        "id",
        "type",
        "hard"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "workface_occupancy",
            "permit_window",
            "isolation_state",
            "simops_exclusion",
            "material_release",
            "mandatory_supervision",
            "alternative_mode",
            "continuity",
            "mobilisation_transition",
            "frozen_horizon",
            "custom_preserved"
          ]
        },
        "hard": {
          "type": "boolean"
        },
        "activity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "resource_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "window_start": {
          "type": [
            "integer",
            "null"
          ]
        },
        "window_finish": {
          "type": [
            "integer",
            "null"
          ]
        },
        "capacity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "$ref": "#/$defs/sourceFields"
        },
        "source_fields": {
          "$ref": "#/$defs/sourceFields"
        }
      },
      "additionalProperties": false
    },
    "stateAssignment": {
      "type": "object",
      "required": [
        "resource_id",
        "demand"
      ],
      "properties": {
        "resource_id": {
          "type": "string"
        },
        "demand": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "activityState": {
      "type": "object",
      "required": [
        "activity_id",
        "start",
        "finish"
      ],
      "properties": {
        "activity_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer"
        },
        "finish": {
          "type": "integer"
        },
        "remaining_duration": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "mode_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "assignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stateAssignment"
          },
          "default": []
        },
        "source_fields": {
          "$ref": "#/$defs/sourceFields"
        }
      },
      "additionalProperties": false
    },
    "scheduleState": {
      "type": "object",
      "required": [
        "state_id",
        "state_type",
        "activity_states"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "state_type": {
          "enum": [
            "baseline",
            "approved_forecast",
            "snapshot"
          ]
        },
        "source_snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "activity_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activityState"
          }
        },
        "source_fields": {
          "$ref": "#/$defs/sourceFields"
        }
      },
      "additionalProperties": false
    },
    "proposedScenario": {
      "type": "object",
      "required": [
        "scenario_id",
        "status",
        "activity_states",
        "objective_policy_id",
        "objective_vector"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "proposed",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "objective_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "objective_vector": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "activity_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activityState"
          }
        },
        "alternative_scenario_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "governance": {
          "$ref": "#/$defs/governance"
        },
        "source_fields": {
          "$ref": "#/$defs/sourceFields"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "governance"
            ],
            "properties": {
              "governance": {
                "allOf": [
                  {
                    "$ref": "#/$defs/governance"
                  },
                  {
                    "required": [
                      "approval_state",
                      "decision_id",
                      "actor",
                      "timestamp"
                    ],
                    "properties": {
                      "approval_state": {
                        "const": "approved"
                      },
                      "decision_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "actor": {
                        "type": "string",
                        "minLength": 1
                      },
                      "timestamp": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "governance"
            ],
            "properties": {
              "governance": {
                "allOf": [
                  {
                    "$ref": "#/$defs/governance"
                  },
                  {
                    "required": [
                      "approval_state",
                      "decision_id",
                      "actor",
                      "timestamp"
                    ],
                    "properties": {
                      "approval_state": {
                        "const": "rejected"
                      },
                      "decision_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "actor": {
                        "type": "string",
                        "minLength": 1
                      },
                      "timestamp": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "evidenceReference": {
      "type": "object",
      "required": [
        "id",
        "path_or_uri",
        "hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path_or_uri": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "properties": {
        "approval_state": {
          "enum": [
            "not_submitted",
            "pending",
            "approved",
            "rejected",
